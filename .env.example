# Lighthouse.storage (IPFS + Filecoin) — primary storage backend
LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here

# Ethereum wallet for Kavach encryption signing (private key never leaves the server)
ETH_PRIVATE_KEY=your_eth_private_key_here_0x...

# Pinata — fallback IPFS storage if Lighthouse is unavailable
PINATA_JWT=your_pinata_jwt_bearer_token_here

# App JWT secret — used to sign session cookies (use a long random string)
JWT_SECRET=your_jwt_secret_here_min_32_chars

# PostgreSQL database (auto-provisioned by Replit — set automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Node environment
NODE_ENV=development
